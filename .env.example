LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional: override the DeepSeek endpoint. Defaults to https://api.deepseek.com.
# Use this to point DeepSeek provider at any OpenAI-compatible Chat Completions endpoint.
# DEEPSEEK_BASE_URL=http://127.0.0.1:8317/v1

TAVILY_API_KEY=your-tavily-api-key

# Model capacity used to budget every Provider request.
AGENT_MODEL_CONTEXT_TOKENS=1048576
AGENT_MODEL_MAX_OUTPUT_TOKENS=32768
# Optional additional cap for completed conversation history.
# AGENT_MAX_HISTORY_TOKENS=64000
# UTF-8 bytes per token, used to convert byte counts into the token budget.
# Defaults to 2.5. A measured Chinese-plus-code coding run came out at 3.59,
# so the default keeps headroom. Raise it only with measurements behind it.
# AGENT_BYTES_PER_TOKEN=2.5

# Node SSE server
HOST=127.0.0.1
PORT=3000
# Relative paths are resolved from the service workspace root.
AGENT_DATABASE_PATH=.data/agent-harness.sqlite
# Project memory root; absolute path. Defaults to
# ~/.my-agent-harness/memory on the service account.
# AGENT_MEMORY_ROOT=/absolute/path/to/memory
# Set this when the browser frontend runs on another origin.
# CORS_ALLOW_ORIGIN=http://localhost:5173

# Feishu (Lark) chat binding bridge. The bridge starts a long connection to the
# Feishu open platform only when BOTH LARK_APP_ID and LARK_APP_SECRET are set;
# leave them empty to keep the web UI and behavior unchanged.
# App ID / Secret come from the Feishu open platform self-built app page.
# LARK_APP_ID=cli_xxx
# LARK_APP_SECRET=your-app-secret
# API and long-connection origin. Defaults to https://open.feishu.cn; use
# https://open.larksuite.com for the international Lark. A bare host name is
# accepted and automatically prefixed with https://.
# LARK_DOMAIN=https://open.feishu.cn
# Optional comma-separated open_id whitelist. Leave empty for unlimited (the
# binding code is the only authorization entry).
# LARK_ALLOWED_OPEN_IDS=ou_xxx,ou_yyy
# NOTE: the same app credentials must be used by only one Westie process at a
# time; enabling the bridge in a second process sends events to one of them
# unpredictably.

# To use OpenAI instead:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=your-openai-model-id

# To use any OpenAI-compatible Chat Completions endpoint (e.g. local model
# gateways, OpenRouter):
# LLM_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_API_KEY=your-api-key
# OPENAI_COMPATIBLE_MODEL=your-model-id
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8317/v1

# MCP server credentials: reference them from ~/.agents/mcp.json or the
# workspace .agents/mcp.json via ${VAR}.
# Put the value here (in .env) and keep only the ${VAR} reference in the
# version-controlled .agents/mcp.json so secrets stay out of the repo.
# GITHUB_PERSONAL_ACCESS_TOKEN=your-token
# DOCS_MCP_TOKEN=your-token
