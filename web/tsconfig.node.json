{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "types": ["vitest/globals"]
  },
  "include": ["vite.config.ts", "src/**/*.ts", "src/**/*.tsx"]
}
